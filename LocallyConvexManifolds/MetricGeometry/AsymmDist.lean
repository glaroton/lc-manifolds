module

public import Mathlib.Topology.EMetricSpace.Basic

/-!
# Asymmetric distances

An **asymmetric (extended) distance** on `X` ([Men13, §1, Definition 1.1]) is a function
`b : X → X → [0, ∞]` with `b(x, x) = 0` and `b(x, z) ≤ b(x, y) + b(y, z)`; it need not be symmetric,
and `b(x, y) = 0` need not force `x = y`. The distances of non-reversible Finsler structures are of
this kind.

Following [Men13, §3.1], the topology of `X` is the one generated by the forward balls
`{y | b(x, y) < ε}` and the backward balls `{y | b(y, x) < ε}` together, that is, the topology of
the symmetrized distance `d(x, y) = max (b(x, y), b(y, x))`. The forward and the backward balls
alone may generate different, coarser topologies ([Men13, Example 4.1]).

The class `AsymmPseudoEMetricSpace X` records `b` (`bdist`) together with the pseudo-(extended)
metric space structure of `d`, so that all the topological and uniform notions of Mathlib refer to
the symmetrized distance. `AsymmPseudoEMetricSpace.ofBDist` builds the structure from `b` alone.

## Main definitions

* `AsymmPseudoEMetricSpace`: an asymmetric distance `bdist` together with the pseudo-(extended)
  metric space structure of the symmetrized distance.
* `AsymmPseudoEMetricSpace.ofBDist`: the structure built from an asymmetric distance alone.

## Main results

* `bdist_self`, `bdist_triangle`: `b(x, x) = 0` and the triangle inequality.
* `edist_eq_max_bdist`: the symmetrized distance is `max (b(x, y), b(y, x))`.
* `bdist_le_edist`, `bdist_le_edist'`: `b` is bounded by the symmetrized distance.

## References

* [A. C. G. Mennucci, *On asymmetric distances*][Men13]
-/

@[expose] public section

open Set Filter
open scoped Topology ENNReal

noncomputable section

namespace LocallyConvex.Manifolds

/-- An **asymmetric pseudo-(extended) metric space**: an asymmetric distance `bdist`, together
with the pseudo-(extended) metric space structure of the symmetrized distance
`edist x y = max (bdist x y) (bdist y x)`. -/
class AsymmPseudoEMetricSpace (X : Type*) extends PseudoEMetricSpace X where
  /-- The asymmetric distance `b(x, y)`, the cost of going from `x` to `y`. -/
  bdist : X → X → ℝ≥0∞
  bdist_self : ∀ x, bdist x x = 0
  bdist_triangle : ∀ x y z, bdist x z ≤ bdist x y + bdist y z
  edist_eq_max : ∀ x y, edist x y = max (bdist x y) (bdist y x)

export AsymmPseudoEMetricSpace (bdist)

variable {X : Type*}

/-- The asymmetric pseudo-(extended) metric space structure defined by an asymmetric distance
`b`: the topology is that of `max (b(x, y), b(y, x))`. -/
@[reducible]
def AsymmPseudoEMetricSpace.ofBDist (b : X → X → ℝ≥0∞) (hself : ∀ x, b x x = 0)
    (htri : ∀ x y z, b x z ≤ b x y + b y z) : AsymmPseudoEMetricSpace X where
  edist x y := max (b x y) (b y x)
  edist_self x := by simp [hself]
  edist_comm x y := max_comm _ _
  edist_triangle x y z :=
    max_le ((htri x y z).trans (add_le_add (le_max_left _ _) (le_max_left _ _)))
      (by
        rw [add_comm]
        exact (htri z y x).trans (add_le_add (le_max_right _ _) (le_max_right _ _)))
  bdist := b
  bdist_self := hself
  bdist_triangle := htri
  edist_eq_max _ _ := rfl

variable [AsymmPseudoEMetricSpace X]

@[simp] theorem bdist_self (x : X) : bdist x x = 0 := AsymmPseudoEMetricSpace.bdist_self x

theorem bdist_triangle (x y z : X) : bdist x z ≤ bdist x y + bdist y z :=
  AsymmPseudoEMetricSpace.bdist_triangle x y z

theorem edist_eq_max_bdist (x y : X) : edist x y = max (bdist x y) (bdist y x) :=
  AsymmPseudoEMetricSpace.edist_eq_max x y

/-- `b ≤ d`. -/
theorem bdist_le_edist (x y : X) : bdist x y ≤ edist x y := by
  rw [edist_eq_max_bdist]; exact le_max_left _ _

/-- `b(y, x) ≤ d(x, y)`. -/
theorem bdist_le_edist' (x y : X) : bdist y x ≤ edist x y := by
  rw [edist_eq_max_bdist]; exact le_max_right _ _

end LocallyConvex.Manifolds
