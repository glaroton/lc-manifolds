/-!
# Lema 9.1.8 fails without completeness of the model

Reference: G. Larotonda, *Estructuras geométricas para las variedades de Banach*, Cap. 9,
§9.1.2, Lema 9.1.8 and Corolario 9.1.9 (`FinslerLengthStructure.continuous_ofFinsler` and
`FinslerLengthStructure.homeomorphFinsler` in `Metric/FinslerBounded.lean`).

Lema 9.1.8 says that if a Finsler structure `μ` on a Hausdorff manifold modeled on a **Banach**
space is bounded below, every open set of `M` is open for the Finsler distance `d_b`; by
Corolario 9.1.9 a strong Finsler structure (bounded above and below) induces the topology of `M`.
The proof is an exit argument (`FinslerLengthStructure.reach_exit`): a curve that leaves the
domain of a chart before its image leaves a ball would have, by completeness, a limit point inside
the ball. We show that **the completeness of the model is necessary**: for every incomplete normed
space `E₀` there is a Hausdorff manifold modeled on `ℝ × E₀` with a strong reversible Finsler
metric for which the identity `(M, d_b) → M` is not continuous
(`exists_not_continuous_ofFinsler`).

## The construction

* **A curve towards a hole** (`GluingCurve`): a smooth curve `c : (-∞, 1) → E₀` with
  `‖c'‖ ≤ K`, `c'(s) → 0` as `s → 1⁻`, and no cluster point in `E₀` as `s → 1⁻`. Every incomplete
  normed space carries one (`GluingCurve.nonempty_of_not_completeSpace`): take a sequence `u`
  without limit such that `‖u (k + 1) - u k‖ < 4⁻ᵏ`, and move from `u k` to `u (k + 1)` by a
  smooth step on `[1 - 2⁻ᵏ, 1 - 2⁻ᵏ⁻¹]` (`Construction.curve`). For `E₀ = c₀₀` with the `ℓ²` norm
  one may think of `c(s) → e₀ ∈ ℓ² ∖ c₀₀`.
* **The manifold** (`Glued c`): two copies of `E = ℝ × E₀` glued along `A = {s < 1}` by
  `τ(s, v) = (s, v + c(s))`. Its points are those of the first copy (`Glued.one`) and the points
  `(s, v)` with `s ≥ 1` of the second copy (`Glued.two`). The two charts `φ₁`, `φ₂` are onto `E`,
  and the topology is the one generated by the atlas (Mathlib's `ChartedSpaceCore`). The
  transition maps `τ` and `τ⁻¹` are smooth on `A`, so `Glued c` is a manifold.
* **Hausdorff** (`Glued.t2Space`): if `(1, a)` in the first copy and `(1, b)` in the second copy
  could not be separated, along the filter `𝓝 (1, a)₁ ⊓ 𝓝 (1, b)₂` we would get `c(s) → b - a`
  with `s → 1⁻`, a cluster point of `c` in `E₀` (`Glued.not_neBot_one_two`).
* **The Finsler metric** (`Glued.μ`): the norm of `E`, read in `φ₁` on the first copy and in `φ₂`
  on the points of the second copy only. On the overlap `Dτ(σ, w) = (σ, w + σ c'(s))`, so `μ` is
  continuous on `TM` because `c'(s) → 0` (`Glued.continuous_μfun`), and bounded above and below
  because `‖c'‖ ≤ K` (`Glued.isBounded`).
* **The failure** (`Glued.not_continuous_ofFinsler`): let `p = (1, 0)` in the first copy and
  `q_δ = (1, c(1 - δ))` in the second one. Going down the first copy from `p` to
  `(1 - δ, 0)₁ = (1 - δ, c(1 - δ))₂`, and then up the second copy along `t ↦ (t, c(1 - δ))₂`,
  shows `d_b(p, q_δ) ≤ (2 + K) δ`, in both directions (`Glued.dist_le`). So `q_δ → p` for `d_b`,
  while no `q_δ` lies in the first copy, an open neighborhood of `p`. The exit argument fails
  where expected (`Glued.not_reach_exit`): the curve `t ↦ (t, 0)₁` leaves the domain of `φ₂` at
  `t = 1`, although `φ₂(t, 0)₁ = (t, c(t))` stays in a ball; its limit lies in the completion of
  `E`, not in `E`.

Compared with the argument on paper, the points `q_δ = (1, c(1 - δ))` replace `(1, w_n)` with
`w_n → e₀`: the segment in the fiber disappears, and two `C¹` arcs suffice. The norm of `E` is
the max norm (Mathlib's product norm) instead of `|σ| + ‖w‖`.

**Source.** We found no source for this counterexample; we do not claim it is new.

## Main results

* `exists_not_continuous_ofFinsler`: for every incomplete normed space `E₀`, a Hausdorff manifold
  modeled on `ℝ × E₀` with a reversible, nondegenerate Finsler metric, bounded above and below,
  such that the identity `(M, d_b) → M` is not continuous;
* `not_completeSpace_c00`, `exists_not_continuous_ofFinsler_c00`: the same on the concrete model
  `ℝ × c₀₀`, where `c₀₀` (finitely supported sequences, `ℓ²` norm) is not complete;
* `Glued.t2Space`, `Glued.mbManifold`, `Glued.isBounded`, `Glued.continuous_μfun`,
  `Glued.not_continuous_ofFinsler`, `Glued.not_reach_exit`: the counterexample built from a
  `GluingCurve`.
-/

@[expose] public section

open Set Filter
open scoped Topology ENNReal ContDiff
open LocallyConvex.Analysis

noncomputable section

namespace LocallyConvex.Manifolds.IncompleteFinsler

universe u

variable {E₀ : Type u} [NormedAddCommGroup E₀] [NormedSpace ℝ E₀]

/-- A **gluing curve** in the normed space `E₀`: a smooth curve `c : (-∞, 1) → E₀` (extended
arbitrarily to `s ≥ 1`) with bounded derivative, `c'(s) → 0` as `s → 1⁻`, and without cluster
points in `E₀` as `s → 1⁻`. It exists exactly when `E₀` is not complete
(`GluingCurve.nonempty_of_not_completeSpace`). -/
structure GluingCurve (E₀ : Type u) [NormedAddCommGroup E₀] [NormedSpace ℝ E₀] where
  /-- The curve. -/
  toFun : ℝ → E₀
  contDiffOn : ContDiffOn ℝ ∞ toFun (Iio 1)
  /-- A bound `K` for `‖c'‖` on `(-∞, 1)`. -/
  bound : ℝ
  norm_deriv_le : ∀ s < 1, ‖deriv toFun s‖ ≤ bound
  tendsto_deriv : Tendsto (deriv toFun) (𝓝[<] 1) (𝓝 0)
  not_mapClusterPt : ∀ z, ¬ MapClusterPt z (𝓝[<] 1) toFun

namespace GluingCurve

variable (c : GluingCurve E₀)

/-- The gluing map `τ(s, v) = (s, v + c(s))`, from the first copy to the second one. -/
def τ (x : ℝ × E₀) : ℝ × E₀ := (x.1, x.2 + c.toFun x.1)

/-- The inverse of the gluing map, `τ⁻¹(s, v) = (s, v - c(s))`. -/
def τinv (x : ℝ × E₀) : ℝ × E₀ := (x.1, x.2 - c.toFun x.1)

@[simp] theorem τ_fst (x : ℝ × E₀) : (c.τ x).1 = x.1 := rfl
@[simp] theorem τinv_fst (x : ℝ × E₀) : (c.τinv x).1 = x.1 := rfl
@[simp] theorem τinv_τ (x : ℝ × E₀) : c.τinv (c.τ x) = x := by simp [τ, τinv]
@[simp] theorem τ_τinv (x : ℝ × E₀) : c.τ (c.τinv x) = x := by simp [τ, τinv]

/-- The half-space `A = {s < 1}`, along which the two copies are glued. -/
def A : Set (ℝ × E₀) := {x | x.1 < 1}

omit [NormedSpace ℝ E₀] in
theorem isOpen_A : IsOpen (A : Set (ℝ × E₀)) := isOpen_lt continuous_fst continuous_const

theorem contDiffOn_comp_fst : ContDiffOn ℝ ∞ (fun x : ℝ × E₀ ↦ c.toFun x.1) A :=
  c.contDiffOn.comp contDiffOn_fst fun _ hx ↦ hx

theorem contDiffOn_τ : ContDiffOn ℝ ∞ c.τ A :=
  contDiffOn_fst.prodMk (contDiffOn_snd.add c.contDiffOn_comp_fst)

theorem contDiffOn_τinv : ContDiffOn ℝ ∞ c.τinv A :=
  contDiffOn_fst.prodMk (contDiffOn_snd.sub c.contDiffOn_comp_fst)

theorem hasDerivAt {s : ℝ} (hs : s < 1) : HasDerivAt c.toFun (deriv c.toFun s) s :=
  ((c.contDiffOn.contDiffAt (Iio_mem_nhds hs)).differentiableAt (by simp)).hasDerivAt

/-- `Dτ(s, v)(σ, w) = (σ, w + σ c'(s))`. -/
theorem hasFDerivAt_τ {x : ℝ × E₀} (hx : x.1 < 1) :
    HasFDerivAt c.τ ((ContinuousLinearMap.fst ℝ ℝ E₀).prod (ContinuousLinearMap.snd ℝ ℝ E₀ +
      (ContinuousLinearMap.fst ℝ ℝ E₀).smulRight (deriv c.toFun x.1))) x := by
  have h := (c.hasDerivAt hx).hasFDerivAt.comp x (hasFDerivAt_fst (𝕜 := ℝ) (p := x))
  refine (hasFDerivAt_fst.prodMk (hasFDerivAt_snd.add h)).congr_fderiv ?_
  ext v <;> simp

/-- `Dτ⁻¹(s, v)(σ, w) = (σ, w - σ c'(s))`. -/
theorem hasFDerivAt_τinv {x : ℝ × E₀} (hx : x.1 < 1) :
    HasFDerivAt c.τinv ((ContinuousLinearMap.fst ℝ ℝ E₀).prod (ContinuousLinearMap.snd ℝ ℝ E₀ -
      (ContinuousLinearMap.fst ℝ ℝ E₀).smulRight (deriv c.toFun x.1))) x := by
  have h := (c.hasDerivAt hx).hasFDerivAt.comp x (hasFDerivAt_fst (𝕜 := ℝ) (p := x))
  refine (hasFDerivAt_fst.prodMk (hasFDerivAt_snd.sub h)).congr_fderiv ?_
  ext v <;> simp

end GluingCurve

/-- **The glued manifold**: two copies of `ℝ × E₀` glued along `{s < 1}` by `τ`. The points are
those of the first copy (`one`) and the points `(s, v)` with `s ≥ 1` of the second one (`two`); a
point `(s, v)` of the second copy with `s < 1` is `one (τ⁻¹ (s, v))`. -/
inductive Glued (c : GluingCurve E₀) : Type u
  | one (x : ℝ × E₀) : Glued c
  | two (x : ℝ × E₀) (h : 1 ≤ x.1) : Glued c

namespace Glued

variable {c : GluingCurve E₀}

/-- The domain of the second chart: the points `(s, v)` with `s < 1` of the first copy, and the
points of the second copy. -/
def InTwo : Glued c → Prop
  | one x => x.1 < 1
  | two _ _ => True

variable (c) in
/-- The first chart `φ₁`, onto `ℝ × E₀`, defined on the first copy. -/
def chart₁ : PartialEquiv (Glued c) (ℝ × E₀) where
  toFun
    | one x => x
    | two x _ => x
  invFun := one
  source := range one
  target := univ
  map_source' _ _ := mem_univ _
  map_target' y _ := mem_range_self y
  left_inv' := by rintro _ ⟨x, rfl⟩; rfl
  right_inv' _ _ := rfl

variable (c) in
/-- The second chart `φ₂`, onto `ℝ × E₀`, defined on the second copy: `φ₂ = τ` on the first copy
over `{s < 1}`. -/
def chart₂ : PartialEquiv (Glued c) (ℝ × E₀) where
  toFun
    | one x => c.τ x
    | two x _ => x
  invFun y := if h : y.1 < 1 then one (c.τinv y) else two y (not_lt.1 h)
  source := {p | InTwo p}
  target := univ
  map_source' _ _ := mem_univ _
  map_target' y _ := by
    by_cases h : y.1 < 1
    · simp only [h, dite_true, mem_ofPred_eq, InTwo]; simpa using h
    · simp only [h, dite_false, mem_ofPred_eq, InTwo]
  left_inv' := by
    rintro (x | ⟨x, hx⟩) hp
    · have hx : x.1 < 1 := hp
      simp [hx]
    · simp [not_lt.2 hx]
  right_inv' y _ := by
    by_cases h : y.1 < 1
    · simp [h]
    · simp [h]

@[simp] theorem chart₁_target : (chart₁ c).target = univ := rfl
@[simp] theorem chart₂_target : (chart₂ c).target = univ := rfl
@[simp] theorem chart₁_one (x : ℝ × E₀) : chart₁ c (one x) = x := rfl
@[simp] theorem chart₂_one (x : ℝ × E₀) : chart₂ c (one x) = c.τ x := rfl
@[simp] theorem chart₂_two (x : ℝ × E₀) (h) : chart₂ c (two x h) = x := rfl
@[simp] theorem chart₁_symm (y : ℝ × E₀) : (chart₁ c).symm y = one y := rfl
theorem chart₂_symm_of_lt {y : ℝ × E₀} (hy : y.1 < 1) :
    (chart₂ c).symm y = one (c.τinv y) := by
  simp [chart₂, PartialEquiv.symm, hy]
theorem chart₂_symm_of_le {y : ℝ × E₀} (hy : 1 ≤ y.1) :
    (chart₂ c).symm y = two y hy := by
  simp [chart₂, PartialEquiv.symm, not_lt.2 hy]

theorem mem_chart₁_source (p : Glued c) : p ∈ (chart₁ c).source ↔ ∃ x, p = one x := by
  simp [chart₁, eq_comm]

theorem mem_chart₂_source (p : Glued c) : p ∈ (chart₂ c).source ↔ InTwo p := Iff.rfl

/-- The transition maps `φ' ∘ φ⁻¹` are smooth on their domains, which are open: they are the
identity on `ℝ × E₀`, and `τ`, `τ⁻¹` on `{s < 1}`. -/
theorem transition (e e' : PartialEquiv (Glued c) (ℝ × E₀))
    (he : e ∈ ({chart₁ c, chart₂ c} : Set _)) (he' : e' ∈ ({chart₁ c, chart₂ c} : Set _)) :
    IsOpen (e.symm.trans e').source ∧
      ContDiffOn ℝ ∞ (e.symm.trans e') (e.symm.trans e').source := by
  rcases he with rfl | rfl <;> rcases he' with rfl | rfl
  · have hs : ((chart₁ c).symm.trans (chart₁ c)).source = univ := by
      ext y; simp [PartialEquiv.trans_source, mem_chart₁_source]
    rw [hs]
    exact ⟨isOpen_univ, contDiffOn_id.congr fun y _ ↦ rfl⟩
  · have hs : ((chart₁ c).symm.trans (chart₂ c)).source = GluingCurve.A := by
      ext y; simp [PartialEquiv.trans_source, mem_chart₂_source, InTwo, GluingCurve.A]
    rw [hs]
    exact ⟨GluingCurve.isOpen_A, c.contDiffOn_τ.congr fun y _ ↦ rfl⟩
  · have hs : ((chart₂ c).symm.trans (chart₁ c)).source = GluingCurve.A := by
      ext y
      simp only [PartialEquiv.trans_source, PartialEquiv.symm_source, chart₂_target, univ_inter,
        mem_preimage, mem_chart₁_source, GluingCurve.A, mem_ofPred_eq]
      by_cases h : y.1 < 1
      · simp [chart₂_symm_of_lt h, h]
      · simp [chart₂_symm_of_le (not_lt.1 h), h]
    rw [hs]
    refine ⟨GluingCurve.isOpen_A, c.contDiffOn_τinv.congr fun y hy ↦ ?_⟩
    simp [chart₂_symm_of_lt (show y.1 < 1 from hy)]
  · have hs : ((chart₂ c).symm.trans (chart₂ c)).source = univ := by
      ext y
      simp only [PartialEquiv.trans_source, PartialEquiv.symm_source, chart₂_target, univ_inter,
        mem_preimage, mem_univ, iff_true]
      exact (chart₂ c).map_target (mem_univ y)
    rw [hs]
    exact ⟨isOpen_univ, contDiffOn_id.congr fun y _ ↦ (chart₂ c).right_inv (mem_univ y)⟩

variable (c) in
/-- The atlas, as a `ChartedSpaceCore`. -/
def core : ChartedSpaceCore (ℝ × E₀) (Glued c) where
  atlas := {chart₁ c, chart₂ c}
  chartAt
    | one _ => chart₁ c
    | two _ _ => chart₂ c
  mem_chart_source
    | one x => (mem_chart₁_source _).2 ⟨x, rfl⟩
    | two _ _ => trivial
  chart_mem_atlas
    | one _ => Or.inl rfl
    | two _ _ => Or.inr rfl
  open_source e e' he he' := (transition e e' he he').1
  continuousOn_toFun e e' he he' := (transition e e' he he').2.continuousOn

/-- The topology generated by the two charts. -/
instance topologicalSpace : TopologicalSpace (Glued c) := (core c).toTopologicalSpace

instance chartedSpace : ChartedSpace (ℝ × E₀) (Glued c) := (core c).toChartedSpace

/-- **`Glued c` is a smooth manifold**: the transition maps `τ`, `τ⁻¹` are smooth on `{s < 1}`. -/
instance mbManifold : MBManifold (ℝ × E₀) (Glued c) where
  compatible := by
    rintro _ _ ⟨_, ⟨e, rfl⟩, ⟨_, ⟨he, rfl⟩, rfl⟩⟩ ⟨_, ⟨e', rfl⟩, ⟨_, ⟨he', rfl⟩, rfl⟩⟩
    refine ⟨?_, ?_⟩
    · obtain ⟨ho, hd⟩ := transition e e' he he'
      exact (smoothMBOn_iff_contDiffOn ho).2 hd
    · obtain ⟨ho, hd⟩ := transition e' e he' he
      exact (smoothMBOn_iff_contDiffOn ho).2 hd

variable (c) in
/-- The first chart, as an element of the atlas. -/
def a₁ : atlas (ℝ × E₀) (Glued c) :=
  ⟨(core c).openPartialHomeomorph (chart₁ c) (Or.inl rfl),
    mem_iUnion₂.2 ⟨chart₁ c, Or.inl rfl, rfl⟩⟩

variable (c) in
/-- The second chart, as an element of the atlas. -/
def a₂ : atlas (ℝ × E₀) (Glued c) :=
  ⟨(core c).openPartialHomeomorph (chart₂ c) (Or.inr rfl),
    mem_iUnion₂.2 ⟨chart₂ c, Or.inr rfl, rfl⟩⟩

theorem prefAtlas_one (x : ℝ × E₀) : prefAtlas (ℝ × E₀) (one x : Glued c) = a₁ c := rfl

theorem prefAtlas_two (x : ℝ × E₀) (h : 1 ≤ x.1) :
    prefAtlas (ℝ × E₀) (two x h : Glued c) = a₂ c := rfl

/-- The atlas consists of the two charts. -/
theorem atlas_cases (i : atlas (ℝ × E₀) (Glued c)) : i = a₁ c ∨ i = a₂ c := by
  obtain ⟨_, h⟩ := i
  obtain ⟨e, he, rfl⟩ := mem_iUnion₂.1 h
  rcases he with rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr rfl

@[simp] theorem a₁_apply (p : Glued c) : (a₁ c).1 p = chart₁ c p := rfl
@[simp] theorem a₂_apply (p : Glued c) : (a₂ c).1 p = chart₂ c p := rfl
@[simp] theorem a₁_symm_apply (y : ℝ × E₀) : (a₁ c).1.symm y = one y := rfl
theorem a₂_symm_apply (y : ℝ × E₀) : (a₂ c).1.symm y = (chart₂ c).symm y := rfl
@[simp] theorem a₁_source : (a₁ c).1.source = (chart₁ c).source := rfl
@[simp] theorem a₂_source : (a₂ c).1.source = (chart₂ c).source := rfl
@[simp] theorem a₁_target : (a₁ c).1.target = univ := rfl
@[simp] theorem a₂_target : (a₂ c).1.target = univ := rfl

theorem one_mem_a₁_source (x : ℝ × E₀) : (one x : Glued c) ∈ (a₁ c).1.source :=
  (mem_chart₁_source _).2 ⟨x, rfl⟩

theorem two_mem_a₂_source (x : ℝ × E₀) (h : 1 ≤ x.1) : (two x h : Glued c) ∈ (a₂ c).1.source :=
  trivial

theorem one_mem_a₂_source {x : ℝ × E₀} (h : x.1 < 1) : (one x : Glued c) ∈ (a₂ c).1.source := h

theorem two_not_mem_a₁_source (x : ℝ × E₀) (h : 1 ≤ x.1) :
    (two x h : Glued c) ∉ (a₁ c).1.source := by
  rintro ⟨y, hy⟩
  cases hy

/-- Two points in the domain of a common chart that cannot be separated coincide. -/
theorem eq_of_neBot_of_mem {e : OpenPartialHomeomorph (Glued c) (ℝ × E₀)} {x y : Glued c}
    (hx : x ∈ e.source) (hy : y ∈ e.source) (h : (𝓝 x ⊓ 𝓝 y).NeBot) : x = y :=
  e.injOn hx hy (tendsto_nhds_unique ((e.continuousAt hx).mono_left inf_le_left)
    ((e.continuousAt hy).mono_left inf_le_right))

/-- The key step of the Hausdorff property: `(1, a)` in the first copy and `(1, b)` in the second
copy cannot be separated only if `c(s)` clusters at `b - a` as `s → 1⁻`. -/
theorem not_neBot_one_two (a b : ℝ × E₀) (hb : 1 ≤ b.1) :
    ¬ (𝓝 (one a : Glued c) ⊓ 𝓝 (two b hb)).NeBot := by
  intro hF
  set F := 𝓝 (one a : Glued c) ⊓ 𝓝 (two b hb)
  have h1 : Tendsto (a₁ c).1 F (𝓝 a) :=
    ((a₁ c).1.continuousAt (one_mem_a₁_source a)).mono_left inf_le_left
  have h2 : Tendsto (a₂ c).1 F (𝓝 b) :=
    ((a₂ c).1.continuousAt (two_mem_a₂_source b hb)).mono_left inf_le_right
  have hev : ∀ᶠ p in F, p ∈ (a₁ c).1.source ∧ p ∈ (a₂ c).1.source :=
    inter_mem (mem_inf_of_left ((a₁ c).1.open_source.mem_nhds (one_mem_a₁_source a)))
      (mem_inf_of_right ((a₂ c).1.open_source.mem_nhds (two_mem_a₂_source b hb)))
  have hev' : ∀ᶠ p in F, ((a₁ c).1 p).1 < 1 ∧ ((a₂ c).1 p).1 = ((a₁ c).1 p).1 ∧
      c.toFun ((a₁ c).1 p).1 = ((a₂ c).1 p).2 - ((a₁ c).1 p).2 := by
    filter_upwards [hev] with p hp
    obtain ⟨⟨z, rfl⟩, hz⟩ := hp
    have hz : z.1 < 1 := hz
    simp [hz, GluingCurve.τ]
  set f : Glued c → ℝ := fun p ↦ ((a₁ c).1 p).1
  have hf1 : Tendsto f F (𝓝 a.1) := (continuous_fst.tendsto _).comp h1
  have hf2 : Tendsto f F (𝓝 b.1) :=
    ((continuous_fst.tendsto _).comp h2).congr' (hev'.mono fun p hp ↦ hp.2.1)
  have hab : a.1 = b.1 := tendsto_nhds_unique hf1 hf2
  have ha1 : a.1 ≤ 1 := le_of_tendsto hf1 (hev'.mono fun p hp ↦ hp.1.le)
  have ha : a.1 = 1 := le_antisymm ha1 (hab ▸ hb)
  have hfW : Tendsto f F (𝓝[<] 1) :=
    tendsto_nhdsWithin_iff.2 ⟨ha ▸ hf1, hev'.mono fun p hp ↦ hp.1⟩
  have hc : Tendsto (c.toFun ∘ f) F (𝓝 (b.2 - a.2)) :=
    (((continuous_snd.tendsto _).comp h2).sub ((continuous_snd.tendsto _).comp h1)).congr'
      (hev'.mono fun p hp ↦ hp.2.2.symm)
  refine c.not_mapClusterPt (b.2 - a.2) ?_
  have hne : (map (c.toFun ∘ f) F).NeBot := map_neBot
  refine hne.mono (le_inf hc ?_)
  rw [← map_map]
  exact map_mono hfW

/-- **`Glued c` is Hausdorff.** Points of the same chart are separated in the chart; the points
`(1, a)₁` and `(1, b)₂` are separated because `c` has no cluster point at `1⁻`. -/
instance t2Space : T2Space (Glued c) := by
  rw [t2_iff_nhds]
  intro x y h
  rcases x with a | ⟨a, ha⟩ <;> rcases y with b | ⟨b, hb⟩
  · exact eq_of_neBot_of_mem (one_mem_a₁_source a) (one_mem_a₁_source b) h
  · by_cases ha : a.1 < 1
    · exact eq_of_neBot_of_mem (one_mem_a₂_source ha) (two_mem_a₂_source b hb) h
    · exact absurd h (not_neBot_one_two a b hb)
  · by_cases hb' : b.1 < 1
    · exact eq_of_neBot_of_mem (two_mem_a₂_source a ha) (one_mem_a₂_source hb') h
    · rw [inf_comm] at h
      exact absurd h (not_neBot_one_two b a ha)
  · exact eq_of_neBot_of_mem (two_mem_a₂_source a ha) (two_mem_a₂_source b hb) h

/-! ### Coordinate changes of tangent vectors -/

theorem tcc_a₁_a₁ (x : ℝ × E₀) (v : ℝ × E₀) :
    tangentCoordChange (a₁ c) (a₁ c) (one x) v = v :=
  tangentCoordChange_self _ (one_mem_a₁_source x) v

theorem tcc_a₂_a₂ (x : ℝ × E₀) (h : 1 ≤ x.1) (v : ℝ × E₀) :
    tangentCoordChange (a₂ c) (a₂ c) (two x h) v = v :=
  tangentCoordChange_self _ (two_mem_a₂_source x h) v

/-- The coordinate change of tangent vectors from `φ₁` to `φ₂` is `Dτ`. -/
theorem tcc_a₁_a₂ {x : ℝ × E₀} (hx : x.1 < 1) (v : ℝ × E₀) :
    tangentCoordChange (a₁ c) (a₂ c) (one x) v = (v.1, v.2 + v.1 • deriv c.toFun x.1) := by
  change dMB c.τ (x, v) = _
  rw [((c.hasFDerivAt_τ hx).hasDirDerivAt v).dMB_eq]
  simp

/-- The coordinate change of tangent vectors from `φ₂` to `φ₁` is `Dτ⁻¹`. -/
theorem tcc_a₂_a₁ {x : ℝ × E₀} (hx : x.1 < 1) (v : ℝ × E₀) :
    tangentCoordChange (a₂ c) (a₁ c) (one x) v = (v.1, v.2 - v.1 • deriv c.toFun x.1) := by
  have hev : (a₁ c).1 ∘ (a₂ c).1.symm =ᶠ[𝓝 (c.τ x)] c.τinv :=
    Filter.eventuallyEq_of_mem (GluingCurve.isOpen_A.mem_nhds (show (c.τ x).1 < 1 from hx))
      fun y hy ↦ by
        simp [a₂_symm_apply, chart₂_symm_of_lt (show y.1 < 1 from hy)]
  change dMB ((a₁ c).1 ∘ (a₂ c).1.symm) (c.τ x, v) = _
  rw [dMB_congr_of_eventuallyEq hev, ((c.hasFDerivAt_τinv (x := c.τ x) hx).hasDirDerivAt v).dMB_eq]
  simp

/-! ### The Finsler metric -/

/-- The shear `(σ, w) ↦ (σ, w + σ d)` has norm at most `1 + ‖d‖` (max norm). -/
theorem norm_shear_le (v : ℝ × E₀) (d : E₀) : ‖(v.1, v.2 + v.1 • d)‖ ≤ (1 + ‖d‖) * ‖v‖ := by
  have h1 := norm_fst_le v
  have h2 := norm_snd_le v
  have h3 : ‖v.2 + v.1 • d‖ ≤ ‖v.2‖ + ‖v.1‖ * ‖d‖ :=
    (norm_add_le _ _).trans (by rw [norm_smul])
  have h0 := norm_nonneg d
  rw [norm_prod_le_iff]
  constructor <;> simp only <;> nlinarith [norm_nonneg v.1]

theorem norm_le_norm_shear (v : ℝ × E₀) (d : E₀) : ‖v‖ ≤ (1 + ‖d‖) * ‖(v.1, v.2 + v.1 • d)‖ := by
  have h := norm_shear_le ((v.1, v.2 + v.1 • d) : ℝ × E₀) (-d)
  simpa [smul_neg] using h

theorem bound_nonneg : 0 ≤ c.bound := (norm_nonneg _).trans (c.norm_deriv_le 0 (by norm_num))

/-- The derivative of `c`, extended by `0` to `s ≥ 1`; it is continuous at every `s ≥ 1`. -/
def derivExt (c : GluingCurve E₀) (s : ℝ) : E₀ := if s < 1 then deriv c.toFun s else 0

theorem continuousAt_derivExt {s₀ : ℝ} (h : 1 ≤ s₀) : ContinuousAt (derivExt c) s₀ := by
  rcases h.lt_or_eq with h | rfl
  · have hev : (fun _ ↦ (0 : E₀)) =ᶠ[𝓝 s₀] derivExt c :=
      (lt_mem_nhds h).mono fun s hs ↦ by simp [derivExt, not_lt.2 hs.le]
    have hs₀ : derivExt c s₀ = 0 := by simp [derivExt, not_lt.2 h.le]
    rw [ContinuousAt, hs₀]
    exact tendsto_const_nhds.congr' hev
  · have h1 : derivExt c 1 = 0 := by simp [derivExt]
    rw [ContinuousAt, h1, ← nhdsLT_sup_nhdsGE, tendsto_sup]
    refine ⟨c.tendsto_deriv.congr' ?_, tendsto_const_nhds.congr' ?_⟩
    · filter_upwards [self_mem_nhdsWithin] with s hs
      simp [derivExt, show s < 1 from hs]
    · filter_upwards [self_mem_nhdsWithin] with s hs
      simp [derivExt, not_lt.2 (show 1 ≤ s from hs)]

variable (c) in
/-- The Finsler function: the norm of a tangent vector, read in the preferred chart. -/
def μfun (p : TangentBundle (ℝ × E₀) (Glued c)) : ℝ := ‖(show ℝ × E₀ from p.2)‖

theorem μfun_mk (x : Glued c) (v : ℝ × E₀) : μfun c ⟨x, v⟩ = ‖v‖ := rfl

/-- **`μ` is continuous on the tangent bundle.** Over `φ₁` it is the norm of the fiber
coordinate. Over `φ₂` it is `(y, w) ↦ ‖Dτ⁻¹(y) w‖ = ‖(w₁, w₂ - w₁ c'(y₁))‖` for `y₁ < 1` and
`‖w‖` for `y₁ ≥ 1`, which is continuous at `y₁ ≥ 1` because `c'(s) → 0` as `s → 1⁻`. -/
theorem continuous_μfun : Continuous (μfun c) := by
  rw [continuous_iff_continuousAt]
  rintro ⟨x, v⟩
  rcases x with a | ⟨a, ha⟩
  · set Φ := tangentChart (a₁ c) (a₁ c).1
    have hp : (⟨one a, v⟩ : TangentBundle (ℝ × E₀) (Glued c)) ∈ Φ.symm.target :=
      (mem_tangentChart_source _ _ _).2 ⟨one_mem_a₁_source a, one_mem_a₁_source a⟩
    rw [Φ.symm.continuousAt_iff_continuousAt_comp_right hp]
    have hF : μfun c ∘ Φ.symm = fun q ↦ ‖q.2‖ := by
      funext q
      change ‖(show ℝ × E₀ from ((tangentChart (a₁ c) (a₁ c).1).symm q).2)‖ = _
      rw [tangentChart_symm_snd]
      exact congrArg norm (tcc_a₁_a₁ q.1 q.2)
    rw [hF]
    exact continuous_snd.norm.continuousAt
  · set Φ := tangentChart (a₂ c) (a₂ c).1
    have hp : (⟨two a ha, v⟩ : TangentBundle (ℝ × E₀) (Glued c)) ∈ Φ.symm.target :=
      (mem_tangentChart_source _ _ _).2 ⟨two_mem_a₂_source a ha, two_mem_a₂_source a ha⟩
    rw [Φ.symm.continuousAt_iff_continuousAt_comp_right hp]
    have hF : μfun c ∘ Φ.symm = fun q ↦ ‖(q.2.1, q.2.2 - q.2.1 • derivExt c q.1.1)‖ := by
      funext q
      change ‖(show ℝ × E₀ from ((tangentChart (a₂ c) (a₂ c).1).symm q).2)‖ = _
      rw [tangentChart_symm_snd]
      by_cases hq : q.1.1 < 1
      · have h := tcc_a₂_a₁ (c := c) (x := c.τinv q.1) hq q.2
        simp only [a₂_symm_apply, chart₂_symm_of_lt hq]
        refine (congrArg norm h).trans ?_
        simp [derivExt, hq]
      · have hq' : 1 ≤ q.1.1 := not_lt.1 hq
        simp only [a₂_symm_apply, chart₂_symm_of_le hq']
        have h := tcc_a₂_a₂ (c := c) q.1 hq' q.2
        simp only [derivExt, hq, ite_false, smul_zero, sub_zero, Prod.mk.eta]
        exact congrArg norm h
    rw [hF]
    have hq : 1 ≤ ((Φ.symm.symm ⟨two a ha, v⟩).1).1 := ha
    have hg : ContinuousAt (fun q : (ℝ × E₀) × (ℝ × E₀) ↦ derivExt c q.1.1)
        (Φ.symm.symm ⟨two a ha, v⟩) :=
      (continuousAt_derivExt (c := c) hq).comp (f := fun q : (ℝ × E₀) × (ℝ × E₀) ↦ q.1.1)
        (by fun_prop)
    exact (continuous_snd.fst.continuousAt.prodMk (continuous_snd.snd.continuousAt.sub
      (continuous_snd.fst.continuousAt.smul hg))).norm

variable (c) in
/-- **The Finsler metric** `μ`: the norm of the first chart on the first copy, the norm of the
second chart at the points of the second copy only. -/
def μ : FinslerMetric (ℝ × E₀) (Glued c) where
  toFun := μfun c
  nonneg' _ := norm_nonneg _
  add_le' _ v w := norm_add_le v w
  smul_eq' _ r hr v := by
    change ‖r • v‖ = r * ‖v‖
    rw [norm_smul, Real.norm_of_nonneg hr]
  continuous_fiber' _ := continuous_norm
  continuous' := continuous_μfun

theorem μ_apply (x : Glued c) (v : ℝ × E₀) : (μ c).toFun ⟨x, v⟩ = ‖v‖ := rfl

theorem isReversible : (μ c).IsReversible := fun _ v ↦ norm_neg v

theorem isNondegenerate : (μ c).IsNondegenerate := fun _ _ h ↦ norm_eq_zero.1 h

/-- On the first copy, `μ` is the norm of `φ₁`. -/
theorem isBoundedBelowOn_a₁ :
    (μ c).toFinslerSeminormField.IsBoundedBelowOn (a₁ c) (a₁ c).1.source 1 := by
  rintro _ ⟨x, rfl⟩ v
  rw [prefAtlas_one, tcc_a₁_a₁, one_mul]
  exact le_rfl

theorem isBoundedAboveOn_a₁ :
    (μ c).toFinslerSeminormField.IsBoundedAboveOn (a₁ c) (a₁ c).1.source 1 := by
  rintro _ ⟨x, rfl⟩ v
  rw [prefAtlas_one, tcc_a₁_a₁, one_mul]
  exact le_rfl

/-- On the domain of the second chart, `μ` is bounded below with constant `1 + K`, where `K`
bounds `‖c'‖`. -/
theorem isBoundedBelowOn_a₂ :
    (μ c).toFinslerSeminormField.IsBoundedBelowOn (a₂ c) (a₂ c).1.source (1 + c.bound) := by
  rintro (x | ⟨x, hx⟩) hxs v
  · have hx : x.1 < 1 := hxs
    rw [prefAtlas_one, tcc_a₁_a₂ hx]
    change _ ≤ (1 + c.bound) * ‖v‖
    refine (norm_shear_le v _).trans ?_
    gcongr
    exact c.norm_deriv_le _ hx
  · rw [prefAtlas_two, tcc_a₂_a₂]
    change ‖v‖ ≤ (1 + c.bound) * ‖v‖
    nlinarith [norm_nonneg v, bound_nonneg (c := c)]

/-- On the domain of the second chart, `μ` is bounded above with constant `(1 + K)⁻¹`. -/
theorem isBoundedAboveOn_a₂ :
    (μ c).toFinslerSeminormField.IsBoundedAboveOn (a₂ c) (a₂ c).1.source (1 + c.bound)⁻¹ := by
  have hK := bound_nonneg (c := c)
  rintro (x | ⟨x, hx⟩) hxs v
  · have hx : x.1 < 1 := hxs
    rw [prefAtlas_one, tcc_a₁_a₂ hx]
    change (1 + c.bound)⁻¹ * ‖v‖ ≤ _
    rw [inv_mul_le_iff₀ (by linarith)]
    refine (norm_le_norm_shear v (deriv c.toFun x.1)).trans ?_
    gcongr
    exact c.norm_deriv_le _ hx
  · rw [prefAtlas_two, tcc_a₂_a₂]
    change (1 + c.bound)⁻¹ * ‖v‖ ≤ ‖v‖
    rw [inv_mul_le_iff₀ (by linarith)]
    nlinarith [norm_nonneg v]

/-- `μ` is **bounded above and below** (a *strong* Finsler structure, *Estructuras*,
Observación 9.1.4). -/
theorem isBounded : (μ c).toFinslerSeminormField.IsBounded := by
  have hK := bound_nonneg (c := c)
  rintro (a | ⟨a, ha⟩)
  · exact ⟨a₁ c, (a₁ c).1.source, (a₁ c).1.open_source, one_mem_a₁_source a, subset_rfl,
      ⟨1, one_pos, isBoundedBelowOn_a₁⟩, ⟨1, one_pos, isBoundedAboveOn_a₁⟩⟩
  · exact ⟨a₂ c, (a₂ c).1.source, (a₂ c).1.open_source, two_mem_a₂_source a ha, subset_rfl,
      ⟨1 + c.bound, by linarith, isBoundedBelowOn_a₂⟩,
      ⟨(1 + c.bound)⁻¹, by positivity, isBoundedAboveOn_a₂⟩⟩

/-! ### Two `C¹` arcs -/

/-- A curve read in a chart whose target is the whole model space is `C¹`. -/
theorem isCkCurve_symm (j : atlas (ℝ × E₀) (Glued c)) (hj : j.1.target = univ)
    {f : ℝ → ℝ × E₀} (hf : ContDiff ℝ 1 f) :
    IsCkCurve (ℝ × E₀) 1 (fun t ↦ j.1.symm (f t)) := by
  refine ⟨j.1.continuousOn_symm.comp_continuous hf.continuous fun t ↦ hj ▸ mem_univ _,
    fun i ↦ ?_⟩
  set U := j.1.target ∩ j.1.symm ⁻¹' i.1.source
  have hU : IsOpen U := isOpen_transition_domain j i
  have hT : ContDiffOn ℝ 1 (i.1 ∘ j.1.symm) U :=
    ((smoothMBOn_iff_contDiffOn hU).1 (smoothMBOn_transition' j i)).of_le (by simp)
  have hpre : (fun t ↦ j.1.symm (f t)) ⁻¹' i.1.source = f ⁻¹' U := by
    ext t; simp [U, hj]
  rw [hpre]
  exact ContDiffOn.contDiffMBOn (k := 1) (hU.preimage hf.continuous)
    (hT.comp hf.contDiffOn fun _ ht ↦ ht)

/-- The directional derivative of a differentiable curve in a normed space is its derivative. -/
theorem dMB_eq_of_hasDerivAt {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] {f : ℝ → F}
    {f' : F} {t : ℝ} (h : HasDerivAt f f' t) : dMB f (t, 1) = f' := by
  rw [(h.hasFDerivAt.hasDirDerivAt 1).dMB_eq]
  simp

variable (c) in
/-- The Finsler length structure of `μ`. -/
abbrev μL : FinslerLengthStructure (ℝ × E₀) (Glued c) := (μ c).toFinslerLengthStructure

/-- A `C¹` curve with speed at most `C` has length at most `C (b - a)` on `[a, b]`. -/
theorem length_le {α : ℝ → Glued c} (hα : IsCkCurve (ℝ × E₀) 1 α) {a b C : ℝ} (hab : a ≤ b)
    (h : ∀ t, (μ c).toFun (velocity (ℝ × E₀) α t) ≤ C) : (μL c).length α a b ≤ C * (b - a) := by
  have hcont := (μL c).continuous_velocity hα
  calc (μL c).length α a b ≤ ∫ _ in a..b, C :=
        intervalIntegral.integral_mono_on hab (hcont.intervalIntegrable _ _)
          intervalIntegrable_const fun t _ ↦ h t
    _ = C * (b - a) := by simp [mul_comm]

variable (c) in
/-- The first arc: the segment `t ↦ (t, 0)` of the first copy. -/
def γ₁ (t : ℝ) : Glued c := one (t, 0)

theorem isCkCurve_γ₁ : IsCkCurve (ℝ × E₀) 1 (γ₁ c) :=
  isCkCurve_symm (a₁ c) rfl (f := fun t ↦ (t, (0 : E₀))) (by fun_prop)

theorem μ_velocity_γ₁ (t : ℝ) : (μ c).toFun (velocity (ℝ × E₀) (γ₁ c) t) = 1 := by
  change ‖dMB (fun s : ℝ ↦ ((s, 0) : ℝ × E₀)) (t, 1)‖ = 1
  rw [show dMB (fun s : ℝ ↦ ((s, 0) : ℝ × E₀)) (t, 1) = ((1 : ℝ), (0 : E₀)) from
    dMB_eq_of_hasDerivAt ((hasDerivAt_id t).prodMk (hasDerivAt_const t (0 : E₀)))]
  simp

theorem length_γ₁_le {a b : ℝ} (hab : a ≤ b) : (μL c).length (γ₁ c) a b ≤ b - a := by
  simpa using length_le isCkCurve_γ₁ hab fun t ↦ (μ_velocity_γ₁ t).le

variable (c) in
/-- The second arc: the segment `t ↦ (t, z)` of the second copy. -/
def γ₂ (z : E₀) (t : ℝ) : Glued c := (a₂ c).1.symm (t, z)

theorem isCkCurve_γ₂ (z : E₀) : IsCkCurve (ℝ × E₀) 1 (γ₂ c z) :=
  isCkCurve_symm (a₂ c) rfl (f := fun t ↦ (t, z)) (by fun_prop)

/-- The speed of the second arc is at most `1 + K`: in `φ₁` its velocity is `(1, -c'(t))`. -/
theorem μ_velocity_γ₂_le (z : E₀) (t : ℝ) :
    (μ c).toFun (velocity (ℝ × E₀) (γ₂ c z) t) ≤ 1 + c.bound := by
  have hK := bound_nonneg (c := c)
  change ‖dMB (chartAt (ℝ × E₀) (γ₂ c z t) ∘ γ₂ c z) (t, 1)‖ ≤ 1 + c.bound
  by_cases ht : t < 1
  · have hpt : γ₂ c z t = one (c.τinv (t, z)) := chart₂_symm_of_lt ht
    have hch : chartAt (ℝ × E₀) (γ₂ c z t) = (a₁ c).1 := by rw [hpt]; rfl
    have hev : chartAt (ℝ × E₀) (γ₂ c z t) ∘ γ₂ c z =ᶠ[𝓝 t] fun s ↦ (s, z - c.toFun s) := by
      filter_upwards [Iio_mem_nhds ht] with s hs
      rw [hch]
      simp [γ₂, a₂_symm_apply, chart₂_symm_of_lt (show (s, z).1 < 1 from hs), GluingCurve.τinv]
    rw [dMB_congr_of_eventuallyEq hev,
      show dMB (fun s ↦ (s, z - c.toFun s)) (t, 1) = ((1 : ℝ), 0 - deriv c.toFun t) from
        dMB_eq_of_hasDerivAt
          ((hasDerivAt_id t).prodMk ((hasDerivAt_const t z).sub (c.hasDerivAt ht)))]
    simp only [Prod.norm_mk, norm_one, zero_sub, norm_neg]
    exact max_le (by linarith) (by linarith [c.norm_deriv_le t ht])
  · have hpt : γ₂ c z t = two (t, z) (not_lt.1 ht) := chart₂_symm_of_le (not_lt.1 ht)
    have hch : chartAt (ℝ × E₀) (γ₂ c z t) = (a₂ c).1 := by rw [hpt]; rfl
    have hfun : chartAt (ℝ × E₀) (γ₂ c z t) ∘ γ₂ c z = fun s ↦ (s, z) := by
      rw [hch]; funext s; exact (a₂ c).1.right_inv (mem_univ _)
    rw [hfun, show dMB (fun s : ℝ ↦ (s, z)) (t, 1) = ((1 : ℝ), (0 : E₀)) from
      dMB_eq_of_hasDerivAt ((hasDerivAt_id t).prodMk (hasDerivAt_const t z))]
    simp only [Prod.norm_mk, norm_one, norm_zero]
    exact max_le (by linarith) (by linarith)

theorem length_γ₂_le (z : E₀) {a b : ℝ} (hab : a ≤ b) :
    (μL c).length (γ₂ c z) a b ≤ (1 + c.bound) * (b - a) :=
  length_le (isCkCurve_γ₂ z) hab (μ_velocity_γ₂_le z)

/-! ### The failure of Lema 9.1.8 -/

variable (c) in
/-- The points `q_δ = (1, c(1 - δ))` of the second copy. -/
def q (δ : ℝ) : Glued c := two (1, c.toFun (1 - δ)) le_rfl

/-- The two arcs meet at `(1 - δ, 0)₁ = (1 - δ, c(1 - δ))₂`. -/
theorem γ₂_start (δ : ℝ) (hδ : 0 < δ) : γ₂ c (c.toFun (1 - δ)) (1 - δ) = γ₁ c (1 - δ) := by
  rw [γ₂, a₂_symm_apply, chart₂_symm_of_lt (show (1 - δ, c.toFun (1 - δ)).1 < 1 by simp [hδ])]
  simp [γ₁, GluingCurve.τinv]

theorem γ₂_end (δ : ℝ) : γ₂ c (c.toFun (1 - δ)) 1 = q c δ :=
  chart₂_symm_of_le le_rfl

/-- **`d_b(p, q_δ) ≤ (2 + K) δ`** in both directions, with `p = (1, 0)` in the first copy. -/
theorem dist_le (δ : ℝ) (hδ : 0 < δ) :
    (μL c).dist (one (1, 0)) (q c δ) ≤ ENNReal.ofReal ((2 + c.bound) * δ) ∧
      (μL c).dist (q c δ) (one (1, 0)) ≤ ENNReal.ofReal ((2 + c.bound) * δ) := by
  have hK := bound_nonneg (c := c)
  have h1δ : 1 - δ ≤ 1 := by linarith
  have hr := isReversible (c := c)
  -- from `x₁ = (1 - δ, 0)` to `p`, along the first arc
  have d1 : (μL c).dist (γ₁ c (1 - δ)) (one (1, 0)) ≤ ENNReal.ofReal δ :=
    ((μL c).dist_le isCkCurve_γ₁ h1δ).trans
      (ENNReal.ofReal_le_ofReal ((length_γ₁_le h1δ).trans (by linarith)))
  -- from `x₁` to `q_δ`, along the second arc
  have d2 : (μL c).dist (γ₁ c (1 - δ)) (q c δ) ≤ ENNReal.ofReal ((1 + c.bound) * δ) := by
    have h := (μL c).dist_le (isCkCurve_γ₂ (c := c) (c.toFun (1 - δ))) h1δ
    rw [γ₂_start δ hδ, γ₂_end] at h
    refine h.trans (ENNReal.ofReal_le_ofReal ((length_γ₂_le _ h1δ).trans (le_of_eq ?_)))
    ring
  have hsum : ENNReal.ofReal δ + ENNReal.ofReal ((1 + c.bound) * δ) =
      ENNReal.ofReal ((2 + c.bound) * δ) := by
    rw [← ENNReal.ofReal_add hδ.le (by positivity)]
    ring_nf
  constructor
  · calc (μL c).dist (one (1, 0)) (q c δ)
        ≤ (μL c).dist (one (1, 0)) (γ₁ c (1 - δ)) + (μL c).dist (γ₁ c (1 - δ)) (q c δ) :=
          (μL c).dist_triangle _ _ _
      _ ≤ ENNReal.ofReal δ + ENNReal.ofReal ((1 + c.bound) * δ) := by
          rw [(μL c).dist_comm hr]
          exact add_le_add d1 d2
      _ = _ := hsum
  · calc (μL c).dist (q c δ) (one (1, 0))
        ≤ (μL c).dist (q c δ) (γ₁ c (1 - δ)) + (μL c).dist (γ₁ c (1 - δ)) (one (1, 0)) :=
          (μL c).dist_triangle _ _ _
      _ ≤ ENNReal.ofReal ((1 + c.bound) * δ) + ENNReal.ofReal δ := by
          rw [(μL c).dist_comm hr (q c δ)]
          exact add_le_add d2 d1
      _ = _ := by rw [add_comm, hsum]

/-- **Lema 9.1.8 fails without completeness.** For the strong Finsler structure `μ` on the
Hausdorff manifold `Glued c`, the identity `(M, d_b) → M` is not continuous. -/
theorem not_continuous_ofFinsler : ¬ Continuous (μL c).ofFinsler := by
  intro hcont
  have hK := bound_nonneg (c := c)
  set p : Glued c := one (1, 0)
  set qs : ℕ → FinslerLengthStructure.FinslerSpace (μL c) :=
    fun n ↦ (μL c).toFinsler (q c (1 / ((n : ℝ) + 1)))
  have hlim : Tendsto qs atTop (𝓝 ((μL c).toFinsler p)) := by
    rw [tendsto_iff_edist_tendsto_0]
    have h0 : Tendsto (fun n : ℕ ↦ ENNReal.ofReal ((2 + c.bound) * (1 / ((n : ℝ) + 1))))
        atTop (𝓝 0) := by
      rw [← ENNReal.ofReal_zero]
      refine ENNReal.tendsto_ofReal ?_
      simpa using tendsto_one_div_add_atTop_nhds_zero_nat.const_mul (2 + c.bound)
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h0
      (fun _ ↦ zero_le) fun n ↦ ?_
    have hd := dist_le (c := c) (1 / ((n : ℝ) + 1)) (by positivity)
    rw [edist_eq_max_bdist]
    exact max_le hd.2 hd.1
  have h2 : Tendsto (fun n ↦ (μL c).ofFinsler (qs n)) atTop (𝓝 p) :=
    (hcont.tendsto _).comp hlim
  obtain ⟨n, hn⟩ := (h2.eventually ((a₁ c).1.open_source.mem_nhds (one_mem_a₁_source _))).exists
  exact two_not_mem_a₁_source _ _ hn


/-- **The exit argument fails** (the conclusion of `FinslerLengthStructure.reach_exit`, which
assumes `[CompleteSpace E]`). In the chart `φ₂`, with `U` its domain and `x₀ = q_δ`, all the
hypotheses of `reach_exit` hold with `C = 1 + K` and `r = 1`, yet the arc `t ↦ (t, 0)` of the first
copy, of length `δ`, leaves `U` from `x = (1 - δ, 0)`, at distance `δ` from `x₀` in the chart. -/
theorem not_reach_exit :
    ∃ (i : atlas (ℝ × E₀) (Glued c)) (U : Set (Glued c)) (C : ℝ) (x₀ : Glued c) (r : ℝ),
      IsOpen U ∧ U ⊆ i.1.source ∧ (μ c).toFinslerSeminormField.IsBoundedBelowOn i U C ∧ 0 < C ∧
      (∀ z ∈ Metric.closedBall (i.1 x₀) r, z ∈ i.1.target ∧ i.1.symm z ∈ U) ∧
      ∃ (x y : Glued c) (L : ℝ), (μL c).Reach x y L ∧ x ∈ U ∧ ‖i.1 x - i.1 x₀‖ < r ∧
        ¬ (r ≤ ‖i.1 x - i.1 x₀‖ + C * L ∨
          (y ∈ U ∧ ‖i.1 y - i.1 x₀‖ ≤ ‖i.1 x - i.1 x₀‖ + C * L)) := by
  have hK := bound_nonneg (c := c)
  set δ : ℝ := (3 + c.bound)⁻¹
  have hδ : 0 < δ := by positivity
  have hδ1 : δ < 1 := inv_lt_one_of_one_lt₀ (by linarith)
  have h1δ : 1 - δ ≤ 1 := by linarith
  have hδK : (2 + c.bound) * δ < 1 := by
    rw [← div_eq_mul_inv, div_lt_one (by linarith)]
    linarith
  have hρ : ‖(a₂ c).1 (γ₁ c (1 - δ)) - (a₂ c).1 (q c δ)‖ = δ := by
    simp [γ₁, q, GluingCurve.τ, abs_of_pos hδ, hδ.le]
  have hL := length_γ₁_le (c := c) h1δ
  refine ⟨a₂ c, (a₂ c).1.source, 1 + c.bound, q c δ, 1, (a₂ c).1.open_source, subset_rfl,
    isBoundedBelowOn_a₂, by linarith, fun z _ ↦ ⟨mem_univ _, (a₂ c).1.map_target (mem_univ z)⟩,
    γ₁ c (1 - δ), γ₁ c 1, (μL c).length (γ₁ c) (1 - δ) 1,
    FinslerLengthStructure.Reach.single isCkCurve_γ₁ h1δ,
    one_mem_a₂_source (show 1 - δ < 1 by linarith), by rw [hρ]; exact hδ1, ?_⟩
  rw [hρ]
  rintro (h | ⟨hy, -⟩)
  · have : (1 + c.bound) * (μL c).length (γ₁ c) (1 - δ) 1 ≤ (1 + c.bound) * δ :=
      mul_le_mul_of_nonneg_left (hL.trans (by linarith)) (by linarith)
    linarith
  · exact lt_irrefl (1 : ℝ) hy

end Glued

/-! ### A gluing curve in every incomplete normed space

Let `u` be a sequence without limit in `E₀` with `dist (u n) (u m) < 4⁻ᴺ` for `n, m ≥ N`. On the
`k`-th step `[1 - 2⁻ᵏ, 1 - 2⁻ᵏ⁻¹]` the curve moves from `u k` to `u (k + 1)` along a smooth
transition, so that near each `s < 1` it is a finite sum of smooth maps, its derivative on the
`k`-th step is at most `2ᵏ⁺¹ B 4⁻ᵏ ≤ 4 B (1 - s)`, and on `[1 - 2⁻ᴺ, 1)` it stays `4⁻ᴺ`-close to
`u N`. A cluster point of the curve at `1⁻` would then be a limit of `u`. -/

namespace Construction

/-- The lengths `h k = 2⁻ᵏ`. -/
def h (k : ℕ) : ℝ := (2 : ℝ)⁻¹ ^ k

theorem h_pos (k : ℕ) : 0 < h k := by unfold h; positivity

theorem h_le_one (k : ℕ) : h k ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)

theorem h_succ (k : ℕ) : h (k + 1) = h k / 2 := by
  simp [h, pow_succ, div_eq_mul_inv]

theorem h_antitone {j k : ℕ} (hjk : j ≤ k) : h k ≤ h j :=
  pow_le_pow_of_le_one (by norm_num) (by norm_num) hjk

theorem h_mul_pow (k : ℕ) : h k * 2 ^ (k + 1) = 2 := by
  rw [h, pow_succ, ← mul_assoc, ← mul_pow]
  norm_num

/-- The `k`-th step: a smooth transition from `0` to `1` on `[1 - h k, 1 - h (k + 1)]`. -/
def bump (k : ℕ) (s : ℝ) : ℝ := Real.smoothTransition ((s - 1 + h k) * 2 ^ (k + 1))

theorem bump_eq_zero {k : ℕ} {s : ℝ} (hs : s ≤ 1 - h k) : bump k s = 0 :=
  Real.smoothTransition.zero_of_nonpos
    (mul_nonpos_of_nonpos_of_nonneg (by linarith) (by positivity))

theorem bump_eq_one {k : ℕ} {s : ℝ} (hs : 1 - h (k + 1) ≤ s) : bump k s = 1 := by
  refine Real.smoothTransition.one_of_one_le ?_
  have h1 : (h k - h (k + 1)) * 2 ^ (k + 1) ≤ (s - 1 + h k) * 2 ^ (k + 1) :=
    mul_le_mul_of_nonneg_right (by linarith) (by positivity)
  have h2 : (h k - h (k + 1)) * 2 ^ (k + 1) = 1 := by
    rw [h_succ, show h k - h k / 2 = h k / 2 by ring, div_mul_eq_mul_div, h_mul_pow]
    norm_num
  linarith

theorem bump_mem (k : ℕ) (s : ℝ) : 0 ≤ bump k s ∧ bump k s ≤ 1 :=
  ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩

theorem contDiff_bump (k : ℕ) : ContDiff ℝ ∞ (bump k) :=
  Real.smoothTransition.contDiff.comp (by fun_prop)

/-- The smooth transition is flat outside `(0, 1)`: it has a minimum or a maximum there. -/
theorem deriv_smoothTransition_eq_zero {x : ℝ} (hx : x ≤ 0 ∨ 1 ≤ x) :
    deriv Real.smoothTransition x = 0 := by
  rcases hx with hx | hx
  · refine IsLocalMin.deriv_eq_zero (Eventually.of_forall fun y ↦ ?_)
    rw [Real.smoothTransition.zero_of_nonpos hx]
    exact Real.smoothTransition.nonneg y
  · refine IsLocalMax.deriv_eq_zero (Eventually.of_forall fun y ↦ ?_)
    rw [Real.smoothTransition.one_of_one_le hx]
    exact Real.smoothTransition.le_one y

/-- The derivative of the smooth transition is bounded: it is continuous and vanishes outside
`[0, 1]`. -/
theorem exists_bound_deriv_smoothTransition :
    ∃ B, 0 ≤ B ∧ ∀ x, ‖deriv Real.smoothTransition x‖ ≤ B := by
  have hc : Continuous (deriv Real.smoothTransition) :=
    (Real.smoothTransition.contDiff (n := 1)).continuous_deriv le_rfl
  obtain ⟨B, hB⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    hc.continuousOn
  refine ⟨max B 0, le_max_right _ _, fun x ↦ ?_⟩
  by_cases hx : x ∈ Icc (0 : ℝ) 1
  · exact (hB x hx).trans (le_max_left _ _)
  · have : x ≤ 0 ∨ 1 ≤ x := by
      simp only [mem_Icc, not_and_or, not_le] at hx
      rcases hx with hx | hx
      · exact Or.inl hx.le
      · exact Or.inr hx.le
    rw [deriv_smoothTransition_eq_zero this, norm_zero]
    exact le_max_right _ _

theorem hasDerivAt_bump (k : ℕ) (s : ℝ) :
    HasDerivAt (bump k)
      (deriv Real.smoothTransition ((s - 1 + h k) * 2 ^ (k + 1)) * 2 ^ (k + 1)) s := by
  have h1 : HasDerivAt (fun s : ℝ ↦ (s - 1 + h k) * 2 ^ (k + 1)) (2 ^ (k + 1)) s := by
    simpa using (((hasDerivAt_id s).sub_const 1).add_const (h k)).mul_const ((2 : ℝ) ^ (k + 1))
  have h2 : HasDerivAt Real.smoothTransition
      (deriv Real.smoothTransition ((s - 1 + h k) * 2 ^ (k + 1)))
      ((s - 1 + h k) * 2 ^ (k + 1)) :=
    (Real.smoothTransition.contDiff (n := 1)).differentiable (by simp) _ |>.hasDerivAt
  exact h2.comp s h1

/-- The derivative of the `k`-th step vanishes outside `(1 - h k, 1 - h (k + 1))`. -/
theorem deriv_bump_ne_zero {k : ℕ} {s : ℝ} (hs : deriv (bump k) s ≠ 0) :
    1 - h k < s ∧ s < 1 - h (k + 1) := by
  rw [(hasDerivAt_bump k s).deriv] at hs
  have hne : deriv Real.smoothTransition ((s - 1 + h k) * 2 ^ (k + 1)) ≠ 0 :=
    left_ne_zero_of_mul hs
  have hx : ¬ ((s - 1 + h k) * 2 ^ (k + 1) ≤ 0 ∨ 1 ≤ (s - 1 + h k) * 2 ^ (k + 1)) :=
    fun hx ↦ hne (deriv_smoothTransition_eq_zero hx)
  push Not at hx
  obtain ⟨hx0, hx1⟩ := hx
  have hp : (0 : ℝ) < 2 ^ (k + 1) := by positivity
  refine ⟨by nlinarith [pos_of_mul_pos_left hx0 hp.le], ?_⟩
  have h2 : (h k - h (k + 1)) * 2 ^ (k + 1) = 1 := by
    rw [h_succ, show h k - h k / 2 = h k / 2 by ring, div_mul_eq_mul_div, h_mul_pow]
    norm_num
  by_contra hc
  push Not at hc
  have : (h k - h (k + 1)) * 2 ^ (k + 1) ≤ (s - 1 + h k) * 2 ^ (k + 1) :=
    mul_le_mul_of_nonneg_right (by linarith) hp.le
  linarith

/-- The derivatives of different steps have disjoint supports. -/
theorem deriv_bump_eq_zero_of_ne {j k : ℕ} (hjk : j ≠ k) {s : ℝ}
    (hk : deriv (bump k) s ≠ 0) : deriv (bump j) s = 0 := by
  by_contra hj
  obtain ⟨hj1, hj2⟩ := deriv_bump_ne_zero hj
  obtain ⟨hk1, hk2⟩ := deriv_bump_ne_zero hk
  rcases lt_or_gt_of_ne hjk with h' | h'
  · have := h_antitone (show j + 1 ≤ k from h'); linarith
  · have := h_antitone (show k + 1 ≤ j from h'); linarith

variable (u : ℕ → E₀)

/-- The curve: `c(s) = u₀ + ∑ₖ bump k s • (u (k + 1) - u k)`; on the `k`-th step it moves from
`u k` to `u (k + 1)`. -/
def curve (s : ℝ) : E₀ := u 0 + ∑' k, bump k s • (u (k + 1) - u k)

/-- Before the `K`-th step only the first `K` steps contribute. -/
theorem curve_eq_sum {K : ℕ} {s : ℝ} (hs : s ≤ 1 - h K) :
    curve u s = u 0 + ∑ k ∈ Finset.range K, bump k s • (u (k + 1) - u k) := by
  rw [curve, tsum_eq_sum (s := Finset.range K)]
  intro k hk
  rw [Finset.mem_range, not_lt] at hk
  rw [bump_eq_zero (hs.trans (by linarith [h_antitone hk])), zero_smul]

/-- On the `k`-th step, `c(s) = u k + bump k s • (u (k + 1) - u k)`. -/
theorem curve_eq_step {k : ℕ} {s : ℝ} (hs1 : 1 - h k ≤ s) (hs2 : s ≤ 1 - h (k + 1)) :
    curve u s = u k + bump k s • (u (k + 1) - u k) := by
  rw [curve_eq_sum u hs2, Finset.sum_range_succ, ← add_assoc]
  congr 1
  have : ∀ j ∈ Finset.range k, bump j s • (u (j + 1) - u j) = u (j + 1) - u j := by
    intro j hj
    rw [Finset.mem_range] at hj
    rw [bump_eq_one ((by linarith [h_antitone (show j + 1 ≤ k from hj)] : 1 - h (j + 1) ≤ s)),
      one_smul]
  rw [Finset.sum_congr rfl this, Finset.sum_range_sub (fun j ↦ u j)]
  abel

theorem exists_h_lt {ε : ℝ} (hε : 0 < ε) : ∃ K, h K < ε :=
  exists_pow_lt_of_lt_one hε (by norm_num)

/-- Near each `s < 1`, the curve is a finite sum of smooth maps. -/
theorem eventuallyEq_sum {s₀ : ℝ} (hs₀ : s₀ < 1) :
    ∃ K, curve u =ᶠ[𝓝 s₀] fun s ↦ u 0 + ∑ k ∈ Finset.range K, bump k s • (u (k + 1) - u k) := by
  obtain ⟨K, hK⟩ := exists_h_lt (show 0 < 1 - s₀ by linarith)
  exact ⟨K, Filter.eventuallyEq_of_mem (Iio_mem_nhds (show s₀ < 1 - h K by linarith))
    fun s hs ↦ curve_eq_sum u (le_of_lt hs)⟩

/-- The curve is smooth on `(-∞, 1)`. -/
theorem contDiffOn_curve : ContDiffOn ℝ ∞ (curve u) (Iio 1) := by
  intro s₀ hs₀
  obtain ⟨K, hK⟩ := eventuallyEq_sum u hs₀
  have hF : ContDiff ℝ ∞ fun s ↦ u 0 + ∑ k ∈ Finset.range K, bump k s • (u (k + 1) - u k) :=
    contDiff_const.add (ContDiff.sum fun k _ ↦ (contDiff_bump k).smul contDiff_const)
  exact (hF.contDiffAt.congr_of_eventuallyEq hK).contDiffWithinAt

variable {u}

/-- **The derivative of the curve is small near `1`**: `‖c'(s)‖ ≤ 4 B (1 - s)` and
`‖c'(s)‖ ≤ 4 B`, if `B` bounds the derivative of the smooth transition. -/
theorem norm_deriv_curve_le {B : ℝ} (hB0 : 0 ≤ B) (hB : ∀ x, ‖deriv Real.smoothTransition x‖ ≤ B)
    (hu : ∀ k, ‖u (k + 1) - u k‖ ≤ (4 : ℝ)⁻¹ ^ k) {s : ℝ} (hs : s < 1) :
    ‖deriv (curve u) s‖ ≤ 4 * B * (1 - s) ∧ ‖deriv (curve u) s‖ ≤ 4 * B := by
  obtain ⟨K, hK⟩ := eventuallyEq_sum u hs
  have hd : HasDerivAt (curve u)
      (∑ k ∈ Finset.range K, deriv (bump k) s • (u (k + 1) - u k)) s := by
    have hsum : HasDerivAt (fun s ↦ ∑ k ∈ Finset.range K, bump k s • (u (k + 1) - u k))
        (∑ k ∈ Finset.range K, deriv (bump k) s • (u (k + 1) - u k)) s :=
      HasDerivAt.fun_sum fun k _ ↦
        ((contDiff_bump k).differentiable (by simp) s).hasDerivAt.smul_const (u (k + 1) - u k)
    exact (hsum.const_add (u 0)).congr_of_eventuallyEq hK
  rw [hd.deriv]
  by_cases hex : ∃ k ∈ Finset.range K, deriv (bump k) s ≠ 0
  · obtain ⟨k, hkK, hk⟩ := hex
    rw [Finset.sum_eq_single k (fun j _ hjk ↦ by rw [deriv_bump_eq_zero_of_ne hjk hk, zero_smul])
      (fun h ↦ absurd hkK h)]
    obtain ⟨hs1, hs2⟩ := deriv_bump_ne_zero hk
    have hb : ‖deriv (bump k) s‖ ≤ B * 2 ^ (k + 1) := by
      rw [(hasDerivAt_bump k s).deriv, norm_mul]
      gcongr
      · exact hB _
      · simp
    have hkey : ‖deriv (bump k) s • (u (k + 1) - u k)‖ ≤ 4 * B * h (k + 1) := by
      rw [norm_smul]
      calc ‖deriv (bump k) s‖ * ‖u (k + 1) - u k‖ ≤ (B * 2 ^ (k + 1)) * (4 : ℝ)⁻¹ ^ k :=
            mul_le_mul hb (hu k) (norm_nonneg _) (by positivity)
        _ = 4 * B * h (k + 1) := by
            rw [h, pow_succ, pow_succ]
            have : (4 : ℝ)⁻¹ ^ k = (2 : ℝ)⁻¹ ^ k * (2 : ℝ)⁻¹ ^ k := by
              rw [← mul_pow]; norm_num
            rw [this]
            have h2 : (2 : ℝ) ^ k * (2 : ℝ)⁻¹ ^ k = 1 := by rw [← mul_pow]; norm_num
            linear_combination (2 * B * (2 : ℝ)⁻¹ ^ k) * h2
    have h1 : h (k + 1) ≤ 1 - s := by linarith
    have h2 : h (k + 1) ≤ 1 := h_le_one _
    exact ⟨hkey.trans (by gcongr), hkey.trans (by nlinarith)⟩
  · push Not at hex
    rw [Finset.sum_eq_zero fun k hk ↦ by rw [hex k hk, zero_smul], norm_zero]
    exact ⟨by nlinarith, by positivity⟩

/-- Every `s ∈ [1 - h N, 1)` lies on some step `k ≥ N`. -/
theorem exists_step {N : ℕ} {s : ℝ} (hs1 : 1 - h N ≤ s) (hs2 : s < 1) :
    ∃ k, N ≤ k ∧ 1 - h k ≤ s ∧ s ≤ 1 - h (k + 1) := by
  have hex : ∃ j, s < 1 - h (j + 1) := by
    obtain ⟨j, hj⟩ := exists_h_lt (show 0 < 1 - s by linarith)
    exact ⟨j, by linarith [h_antitone (Nat.le_succ j)]⟩
  classical
  set k := Nat.find hex
  have hk : s < 1 - h (k + 1) := Nat.find_spec hex
  refine ⟨k, ?_, ?_, hk.le⟩
  · by_contra hlt
    push Not at hlt
    have := h_antitone (show k + 1 ≤ N from hlt)
    linarith
  · rcases Nat.eq_zero_or_eq_succ_pred k with h0 | hsucc
    · rw [h0]
      have := h_le_one N
      simp only [h, pow_zero]
      linarith
    · have hmin := Nat.find_min hex (show k - 1 < k by omega)
      push Not at hmin
      rwa [Nat.sub_add_cancel (by omega)] at hmin

/-- On `[1 - h N, 1)` the curve stays `B_N`-close to `u N`. -/
theorem norm_curve_sub_le (hu : ∀ N n m, N ≤ n → N ≤ m → dist (u n) (u m) < (4 : ℝ)⁻¹ ^ N)
    {N : ℕ} {s : ℝ} (hs1 : 1 - h N ≤ s) (hs2 : s < 1) :
    ‖curve u s - u N‖ ≤ (4 : ℝ)⁻¹ ^ N := by
  obtain ⟨k, hNk, hk1, hk2⟩ := exists_step hs1 hs2
  rw [curve_eq_step u hk1 hk2]
  obtain ⟨hb0, hb1⟩ := bump_mem k s
  set b := bump k s
  have heq : u k + b • (u (k + 1) - u k) - u N = (1 - b) • (u k - u N) + b • (u (k + 1) - u N) := by
    simp only [sub_smul, one_smul, smul_sub]
    abel
  rw [heq]
  have h1 : ‖u k - u N‖ ≤ (4 : ℝ)⁻¹ ^ N := by
    rw [← dist_eq_norm]; exact (hu N k N hNk le_rfl).le
  have h2 : ‖u (k + 1) - u N‖ ≤ (4 : ℝ)⁻¹ ^ N := by
    rw [← dist_eq_norm]; exact (hu N (k + 1) N (by omega) le_rfl).le
  calc ‖(1 - b) • (u k - u N) + b • (u (k + 1) - u N)‖
      ≤ (1 - b) * ‖u k - u N‖ + b * ‖u (k + 1) - u N‖ := by
        refine (norm_add_le _ _).trans ?_
        rw [norm_smul, norm_smul, Real.norm_of_nonneg (by linarith), Real.norm_of_nonneg hb0]
    _ ≤ (1 - b) * (4 : ℝ)⁻¹ ^ N + b * (4 : ℝ)⁻¹ ^ N := by gcongr
    _ = (4 : ℝ)⁻¹ ^ N := by ring

/-- If the sequence does not converge, the curve has no cluster point at `1⁻`. -/
theorem not_mapClusterPt_curve
    (hu : ∀ N n m, N ≤ n → N ≤ m → dist (u n) (u m) < (4 : ℝ)⁻¹ ^ N)
    (hconv : ∀ x, ¬ Tendsto u atTop (𝓝 x)) (z : E₀) :
    ¬ MapClusterPt z (𝓝[<] 1) (curve u) := by
  intro hz
  have hN : ∀ N, ‖z - u N‖ ≤ (4 : ℝ)⁻¹ ^ N := by
    intro N
    refine le_of_forall_pos_lt_add fun ε hε ↦ ?_
    have hfr := (mapClusterPt_iff_frequently.1 hz) (Metric.ball z ε) (Metric.ball_mem_nhds z hε)
    have hev : ∀ᶠ s in 𝓝[<] (1 : ℝ), s ∈ Ico (1 - h N) 1 :=
      Ico_mem_nhdsLT (by linarith [h_pos N])
    obtain ⟨s, hs, hsI⟩ := (hfr.and_eventually hev).exists
    have h1 := norm_curve_sub_le hu hsI.1 hsI.2
    rw [Metric.mem_ball, dist_eq_norm] at hs
    calc ‖z - u N‖ ≤ ‖z - curve u s‖ + ‖curve u s - u N‖ := norm_sub_le_norm_sub_add_norm_sub _ _ _
      _ < ε + (4 : ℝ)⁻¹ ^ N := by rw [norm_sub_rev]; linarith
      _ = (4 : ℝ)⁻¹ ^ N + ε := add_comm _ _
  refine hconv z (Metric.tendsto_atTop.2 fun ε hε ↦ ?_)
  obtain ⟨N, hN'⟩ := exists_pow_lt_of_lt_one hε (show (4 : ℝ)⁻¹ < 1 by norm_num)
  refine ⟨N, fun n hn ↦ ?_⟩
  rw [dist_eq_norm, norm_sub_rev]
  exact (hN n).trans_lt ((pow_le_pow_of_le_one (by norm_num) (by norm_num) hn).trans_lt hN')

end Construction

/-! ### Every incomplete normed space carries a gluing curve -/

namespace GluingCurve

/-- **Every incomplete normed space carries a gluing curve**: take a non-convergent sequence with
`‖u (k + 1) - u k‖ < 4⁻ᵏ` and join its terms by smooth steps (`Construction.curve`). -/
theorem nonempty_of_not_completeSpace (h : ¬ CompleteSpace E₀) : Nonempty (GluingCurve E₀) := by
  obtain ⟨u, hu, hconv⟩ : ∃ u : ℕ → E₀,
      (∀ N n m, N ≤ n → N ≤ m → dist (u n) (u m) < (4 : ℝ)⁻¹ ^ N) ∧
        ∀ x, ¬ Tendsto u atTop (𝓝 x) := by
    by_contra hcon
    push Not at hcon
    exact h (Metric.complete_of_convergent_controlled_sequences _ (fun N ↦ by positivity) hcon)
  obtain ⟨B, hB0, hB⟩ := Construction.exists_bound_deriv_smoothTransition
  have hu' : ∀ k, ‖u (k + 1) - u k‖ ≤ (4 : ℝ)⁻¹ ^ k := fun k ↦ by
    rw [← dist_eq_norm]
    exact (hu k (k + 1) k (by omega) le_rfl).le
  have hlim : Tendsto (fun s : ℝ ↦ 4 * B * (1 - s)) (𝓝[<] 1) (𝓝 0) :=
    tendsto_nhdsWithin_of_tendsto_nhds
      ((show Continuous fun s : ℝ ↦ 4 * B * (1 - s) by fun_prop).tendsto' 1 0 (by simp))
  exact ⟨{
    toFun := Construction.curve u
    contDiffOn := Construction.contDiffOn_curve u
    bound := 4 * B
    norm_deriv_le := fun _ hs ↦ (Construction.norm_deriv_curve_le hB0 hB hu' hs).2
    tendsto_deriv := squeeze_zero_norm'
      (eventually_nhdsWithin_of_forall fun _ hs ↦
        (Construction.norm_deriv_curve_le hB0 hB hu' hs).1) hlim
    not_mapClusterPt := Construction.not_mapClusterPt_curve hu hconv }⟩

end GluingCurve

/-! ### The main theorems -/

/-- **Lema 9.1.8 and Corolario 9.1.9 of *Estructuras* fail without completeness.** For every
incomplete normed space `E₀` there are a Hausdorff manifold `M` modeled on `ℝ × E₀` and a
reversible Finsler metric `μ` on `M`, whose seminorms are norms, which is bounded above and below
(a *strong* Finsler structure), and such that the identity `(M, d_b) → M` is not continuous.
Compare `FinslerLengthStructure.continuous_ofFinsler` and `homeomorphFinsler`, which assume
`[CompleteSpace E]`. -/
theorem exists_not_continuous_ofFinsler (h : ¬ CompleteSpace E₀) :
    ∃ (M : Type u) (_ : TopologicalSpace M) (_ : ChartedSpace (ℝ × E₀) M)
      (_ : MBManifold (ℝ × E₀) M) (_ : T2Space M) (μ : FinslerMetric (ℝ × E₀) M),
      μ.IsReversible ∧ μ.IsNondegenerate ∧ μ.toFinslerSeminormField.IsBounded ∧
        ¬ Continuous μ.toFinslerLengthStructure.ofFinsler := by
  obtain ⟨c⟩ := GluingCurve.nonempty_of_not_completeSpace h
  exact ⟨Glued c, inferInstance, inferInstance, inferInstance, inferInstance, Glued.μ c,
    Glued.isReversible, Glued.isNondegenerate, Glued.isBounded, Glued.not_continuous_ofFinsler⟩

/-! ### A concrete incomplete model: finitely supported sequences in `ℓ²` -/

/-- The space `c₀₀` of finitely supported sequences, as a subspace of `ℓ²`. -/
def c00 : Submodule ℝ (lp (fun _ : ℕ ↦ ℝ) 2) where
  carrier := {x | (Function.support (x : ℕ → ℝ)).Finite}
  add_mem' {x y} hx hy := (hx.union hy).subset (by
    rw [lp.coeFn_add]
    exact Function.support_add _ _)
  zero_mem' := by
    change (Function.support ⇑(0 : lp (fun _ : ℕ ↦ ℝ) 2)).Finite
    rw [lp.coeFn_zero]
    simp
  smul_mem' r x hx := hx.subset (by
    rw [lp.coeFn_smul]
    exact Function.support_const_smul_subset r _)

theorem single_mem_c00 (i : ℕ) (a : ℝ) : lp.single 2 i a ∈ c00 := by
  refine (Set.finite_singleton i).subset fun j hj ↦ ?_
  by_contra hji
  exact hj (by simp [lp.single_apply, show j ≠ i from hji])

/-- **`c₀₀` with the `ℓ²` norm is not complete**: the sequence `(2⁻ⁱ)ᵢ ∈ ℓ²` is a limit of
elements of `c₀₀`, but it is not finitely supported. -/
theorem not_completeSpace_c00 : ¬ CompleteSpace c00 := by
  intro hc
  have hcl : IsClosed (c00 : Set (lp (fun _ : ℕ ↦ ℝ) 2)) :=
    (completeSpace_coe_iff_isComplete.1 hc).isClosed
  have hmem : Memℓp (fun i : ℕ ↦ (2 : ℝ)⁻¹ ^ i) 2 := by
    refine memℓp_gen ?_
    have : (fun i : ℕ ↦ ‖(2 : ℝ)⁻¹ ^ i‖ ^ (2 : ℝ≥0∞).toReal) = fun i ↦ ((4 : ℝ)⁻¹) ^ i := by
      funext i
      rw [norm_pow, Real.norm_of_nonneg (by norm_num), ENNReal.toReal_ofNat, Real.rpow_two,
        ← pow_mul, mul_comm, pow_mul]
      norm_num
    rw [this]
    exact summable_geometric_of_lt_one (by norm_num) (by norm_num)
  set f : lp (fun _ : ℕ ↦ ℝ) 2 := ⟨fun i ↦ (2 : ℝ)⁻¹ ^ i, hmem⟩
  have hf : f ∈ c00 := hcl.mem_of_tendsto (lp.hasSum_single (by norm_num) f).tendsto_sum_nat
    (Eventually.of_forall fun n ↦ Submodule.sum_mem _ fun i _ ↦ single_mem_c00 i _)
  have hfin : (Function.support (f : ℕ → ℝ)).Finite := hf
  refine Set.infinite_univ (hfin.subset fun i _ ↦ ?_)
  change (2 : ℝ)⁻¹ ^ i ≠ 0
  positivity

/-- The counterexample on the concrete model `ℝ × c₀₀`. -/
theorem exists_not_continuous_ofFinsler_c00 :
    ∃ (M : Type) (_ : TopologicalSpace M) (_ : ChartedSpace (ℝ × c00) M)
      (_ : MBManifold (ℝ × c00) M) (_ : T2Space M) (μ : FinslerMetric (ℝ × c00) M),
      μ.IsReversible ∧ μ.IsNondegenerate ∧ μ.toFinslerSeminormField.IsBounded ∧
        ¬ Continuous μ.toFinslerLengthStructure.ofFinsler :=
  exists_not_continuous_ofFinsler not_completeSpace_c00

end LocallyConvex.Manifolds.IncompleteFinsler
